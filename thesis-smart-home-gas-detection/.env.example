# Global
COMPOSE_PROJECT_NAME=thesis-gas-detection
TZ=Asia/Ho_Chi_Minh

# MQTT
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SENSOR=sensors/gas
MQTT_KEEPALIVE=300
MQTT_QOS=0
MQTT_PUBLISH_TIMEOUT_SEC=5

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_RAW_GAS=gas.raw.sensor
KAFKA_TOPIC_ALERT=gas.alert.events
KAFKA_TOPIC_ACTION=gas.action.events
KAFKA_ALERT_GROUP_ID=gas-backend-alerts-v2
KAFKA_ACTION_GROUP_ID=gas-backend-actions-v2

# InfluxDB 2.7
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=thesis-org
INFLUXDB_BUCKET_GAS=gas_sensor_data
INFLUXDB_BUCKET_ALERT=gas_alerts
INFLUXDB_TOKEN=thesis-super-token
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123456

# PostgreSQL 16
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gas_metadata
POSTGRES_USER=gas_admin
POSTGRES_PASSWORD=gas_admin_123

# Node.js backend
NODE_ENV=development
API_PORT=3000
JWT_SECRET=replace_me

# Frontend
FRONTEND_PORT=8080
# ⚠ BACKEND_BASE_URL is rendered into browser HTML — must be accessible from
#   the user's browser (host machine), NOT from inside Docker.
#   Use http://127.0.0.1:3000 (or your server IP if deploying remotely).
BACKEND_BASE_URL=http://127.0.0.1:3000

# Telegram alerts (optional)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=8693857035:AAFMiAt1BMoVZI89YIUpoOKW7vCuCoUwS1Q
TELEGRAM_CHAT_ID=8561028127
TELEGRAM_MIN_RISK_SCORE=0.4
TELEGRAM_COOLDOWN_SEC=5
TELEGRAM_MONITOR_INTERVAL_SEC=1
TELEGRAM_NOTIFY_FROM_KAFKA=true
TELEGRAM_RISK_LABELS=WARNING,ALERT,CRITICAL

# Model paths  (Docker volume: ./processing → /app inside processing-engine)
LSTM_MODEL_PATH=/app/ml/lstm/best_lstm_uci.keras
FORECAST_MODEL_PATH=/app/ml/lstm/gas_forecaster.keras
RL_MODEL_PATH=/app/ml/rl/ppo_gas_agent.zip

# Legacy anomaly LSTM thresholds (kept for backward comparison)
LSTM_ALERT_THRESHOLD=0.7
LSTM_WARNING_THRESHOLD=0.4

# Forecasting LSTM (predict P(critical in next H seconds))
FORECAST_HORIZON_SECONDS=300
FORECAST_CRITICAL_PPM=1000
FORECAST_SEQ_LEN=60
FORECAST_ALERT_THRESHOLD=0.7
FORECAST_WARN_THRESHOLD=0.4
GAS_ALERT_PPM=1000
GAS_WARNING_PPM=700
TELEGRAM_SEND_FROM_PROCESSING=false
ALERT_MAX_AGE_SEC=120
DISPLAY_TIME_ZONE=Asia/Ho_Chi_Minh
DASHBOARD_LATEST_MAX_AGE_SEC=180

# Simulator (realistic leak scenarios)
SIM_PUBLISH_HZ=1.0
SIM_LEAK_PROB_PER_MIN=0.10
SIM_CRITICAL_PPM=1000
SPARK_KAFKA_TIMEOUT_MS=120000
SPARK_KAFKA_OFFSET_RETRIES=10
SPARK_KAFKA_OFFSET_RETRY_INTERVAL_MS=10000
SPARK_CHECKPOINT_LOCATION=/tmp/spark-checkpoints/gas-realtime
RAW_SENSOR_MAX_AGE_SEC=120
RESET_SPARK_CHECKPOINT_ON_START=true

# Spark streaming
SPARK_MASTER=local[2]
SPARK_SQL_SHUFFLE_PARTITIONS=1
SPARK_DEFAULT_PARALLELISM=2
SPARK_MAX_OFFSETS_PER_TRIGGER=200
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TF_NUM_INTRAOP_THREADS=1
TF_NUM_INTEROP_THREADS=1
RAW_SENSOR_USE_INGEST_TIME=true
LSTM_LEGACY_ENABLED=false
RL_MODEL_LOAD_ENABLED=false
SIM_RAW_INFLUX_WRITE_ENABLED=true
